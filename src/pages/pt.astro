        Conversor de <span class="text-red-600 dark:text-red-500">YouTube para MP3</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-sm sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Converta e baixe seus vídeos e Shorts favoritos do YouTube para faixas de áudio MP3 de 320kbps com qualidade cristalina em segundos. 100% Gratuito e Ilimitado.
      </p>
    </div>

    <!-- Center Converter Tool -->
    <div class="mt-8 sm:mt-12">
      <Converter
        badgeText="Compatível com Vídeos e Shorts"
        formTitle="Cole o Link do YouTube"
        formSubtitle="Converta vídeos padrão, músicas e Shorts do YouTube para MP3 de 320kbps com qualidade de estúdio"
        placeholder="https://www.youtube.com/watch?v=... ou URL de Shorts"
        pasteBtnText="Colar"
        qualityLabel="Selecione a Qualidade do Áudio MP3"
        ultraHdLabel="Ultra HD"
        highQualityLabel="Alta Qualidade"
        standardLabel="Padrão"
        compactLabel="Compacto"
        voiceLabel="Voz / Fala"
        convertBtnText="Converter para MP3"
        errorMessage="Por favor, insira um link válido do YouTube."
        downloadBtnText="Baixar MP3"
        convertAnotherText="Converter outro vídeo"
        livePreviewText="Pré-visualização do Áudio"
        readyToPlayText="Pronto para reproduzir"
        clickPlayText="Clique em reproduzir para ouvir a pré-visualização"
        verifiedTrackText="Faixa verificada"
        noteText="MP3 real de duração completa extraído diretamente pelo mecanismo do Saver For TUBE. Áudio de alta fidelidade."
      />
    </div>
  </section>

  <!-- How It Works (Step by Step Guide) -->
  <section class="py-14 sm:py-20 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white">
          Como Converter YouTube para MP3
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
          Siga estes 3 passos simples para baixar o áudio de qualquer vídeo do YouTube em segundos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 rounded-xl p-6 space-y-4">
          <div class="w-10 h-10 rounded-lg bg-red-50 dark:bg-red-950/80 text-red-600 dark:text-red-400 font-bold text-base flex items-center justify-center border border-red-200 dark:border-red-800/80">
            01
