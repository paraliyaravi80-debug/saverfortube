---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us - Saver For TUBE Support Desk"
  description="Get in touch with the Saver For TUBE team for technical assistance, bug reports, DMCA copyright notices, and feature feedback at ravisapps@gmail.com."
  canonicalUrl="https://saverfortube.com/contact"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <!-- Header -->
    <div class="space-y-3 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/60">
        Support &amp; Help Desk
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Get in Touch with Saver For TUBE
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Have questions, encountered a conversion error, or need to submit a legal/DMCA inquiry? Our technical support team is here to assist you promptly.
      </p>
    </div>

    <!-- 4 Quick Support Channel Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Card 1: Technical & Bug Support -->
      <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 rounded-xl p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Technical Support</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Report failed video extractions, bitrate issues, or browser errors. Please include your URL and device.
        </p>
      </div>

      <!-- Card 2: DMCA & Copyright Legal Desk -->
      <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 rounded-xl p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white">DMCA &amp; Legal Desk</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Rights holders can submit URL block notices directly to our legal desk for expedited processing.
        </p>
      </div>

      <!-- Card 3: Direct Email Support -->
      <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 rounded-xl p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Direct Email</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Write directly to <a href="mailto:ravisapps@gmail.com" class="text-red-600 dark:text-red-400 font-semibold hover:underline">ravisapps@gmail.com</a>. Response time: 24–48 hours.
        </p>
      </div>

      <!-- Card 4: Feedback & Suggestions -->
      <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 rounded-xl p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
          </svg>
        </div>
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white">Suggestions</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Request new audio formats, UI enhancements, or recommend features for future updates.
        </p>
      </div>
    </div>

    <!-- Main Form & Side Help Column -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Interactive Contact Form -->
      <div class="lg:col-span-2 border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="space-y-1">
          <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white">
            Send Us a Message
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
            Fill out the form below and our team will get back to you within 24–48 business hours.
          </p>
        </div>

        <!-- Success/Notification Message Container -->
        <div id="form-success-banner" class="hidden p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 text-xs sm:text-sm space-y-1">
          <p class="font-bold flex items-center gap-1.5">
            <span>✓</span> Message Sent Successfully!
          </p>
          <p>
            Thank you for reaching out to Saver For TUBE. We have received your inquiry and will reply to your email address shortly.
          </p>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Full Name -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                name="name"
                required
                placeholder="e.g. John Doe"
                class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
              />
            </div>

            <!-- Email Address -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Inquiry Category -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                Inquiry Category <span class="text-red-500">*</span>
              </label>
              <select
                name="category"
                required
                class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
              >
                <option value="Technical Support / Bug Report">Technical Support / Bug Report</option>
                <option value="DMCA / Copyright Notice">DMCA / Copyright Notice</option>
                <option value="Feedback & Feature Request">Feedback &amp; Feature Request</option>
                <option value="General Question">General Question</option>
              </select>
            </div>

            <!-- YouTube Video Link (Optional for Bug Reports) -->
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                YouTube URL <span class="text-zinc-400 font-normal">(Optional for Bugs)</span>
              </label>
              <input
                type="url"
                name="youtubeUrl"
                placeholder="https://youtube.com/watch?v=..."
                class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
              />
            </div>
          </div>

          <!-- Subject -->
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
              Subject <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="subject"
              required
              placeholder="Brief summary of your inquiry..."
              class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
            />
          </div>

          <!-- Message Area -->
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
              Message <span class="text-red-500">*</span>
            </label>
            <textarea
              name="message"
              rows="5"
              required
              placeholder="Describe your question, issue, or request in detail..."
              class="w-full px-4 py-3 text-xs sm:text-sm bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 rounded-xl focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500"
            ></textarea>
          </div>

          <!-- Privacy Note -->
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
            We value your privacy. Email addresses submitted through this contact portal are used exclusively for support correspondence and are never shared or sold to third parties.
          </p>

          <!-- Submit Button -->
          <button
            id="submit-btn"
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm text-white bg-red-600 hover:bg-red-700 dark:bg-red-500 dark:hover:bg-red-600 transition-colors cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Side Column: Self-Help & Direct Contact Info -->
      <div class="space-y-6">
        <!-- Self-Help Box -->
        <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 rounded-2xl p-6 space-y-3">
          <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-white flex items-center gap-2">
            <span class="text-amber-500">💡</span> Quick Troubleshooting Tips
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Before reporting an extraction error, please verify the following:
          </p>
          <ul class="space-y-2 text-xs text-zinc-600 dark:text-zinc-400 list-disc list-inside">
            <li><strong>Public Videos Only:</strong> Ensure the video is not private, unlisted, or restricted.</li>
            <li><strong>Completed Live Streams:</strong> Active live streams cannot be transcoded until finalized.</li>
            <li><strong>Browser Cache:</strong> If conversion stalls, test on an incognito window or clear browser cache.</li>
          </ul>
        </div>

        <!-- Official Support Box -->
        <div class="border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 rounded-2xl p-6 space-y-3">
          <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-white">
            Official Support Desk
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Prefer direct email? Send your inquiry to our central mailbox:
          </p>
          <div class="p-3 rounded-lg bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800">
            <p class="text-xs text-zinc-500 dark:text-zinc-400">Primary Support Email:</p>
            <a
              href="mailto:ravisapps@gmail.com"
              class="text-xs sm:text-sm font-semibold text-red-600 dark:text-red-400 hover:underline break-all"
            >
              ravisapps@gmail.com
            </a>
          </div>
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400">
            Operating Hours: Monday – Saturday (GMT+0)<br/>Typical response time is 24 to 48 hours.
          </p>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    const contactForm = document.getElementById('contact-form');
    const successBanner = document.getElementById('form-success-banner');
    const submitBtn = document.getElementById('submit-btn');

    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Show loading state
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Sending Message...';

        setTimeout(() => {
          contactForm.reset();
          successBanner.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Send Message</span><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>';
          
          window.scrollTo({
            top: successBanner.offsetTop - 100,
            behavior: 'smooth'
          });
        }, 800);
      });
    }
  </script>
</Layout>
