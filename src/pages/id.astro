            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-zinc-900 dark:text-white">100% Aman & Privat</h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Tanpa pendaftaran, tanpa pengumpulan data pribadi, dan bebas malware. Kami menghargai privasi pengguna dan menjaga protokol browser yang bersih.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 rounded-xl p-6 space-y-3">
