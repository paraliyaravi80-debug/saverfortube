---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-3">
        <a href="/" class="flex items-center gap-3" aria-label="Saver For TUBE">
          <img
            src="/favicon.svg"
            alt="Saver For TUBE Logo"
            class="w-9 h-9 rounded-lg shrink-0 object-contain"
            width="36"
            height="36"
            loading="lazy"
          />
          <span class="text-lg font-bold text-zinc-900 dark:text-white">
            Saver For <span class="text-red-600 dark:text-red-500 font-extrabold">TUBE</span>
          </span>
        </a>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
          The fastest and cleanest online YouTube to MP3 audio converter. Convert YouTube videos and Shorts into crystal-clear 320kbps MP3 audio tracks with zero waiting time and no software required.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200">
          Navigation
        </p>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="/" title="YouTube to MP3 Converter" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
              YouTube to MP3
            </a>
          </li>
          <li>
            <a href="/about-us" title="About Us - Saver For TUBE" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
              About Us
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200">
          Legal & Info
        </p>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="/privacy-policy" title="Privacy Policy - Saver For TUBE" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms-of-use" title="Terms of Use - Saver For TUBE" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
              Terms of Use
            </a>
          </li>
          <li>
            <a href="/contact" title="Contact Us - Saver For TUBE" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white">
              Contact Us
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 border-t border-zinc-200 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500 dark:text-zinc-500">
      <p>
        © {currentYear} Saver For TUBE (saverfortube.com). All rights reserved.
      </p>
      <p class="text-center sm:text-right">
        Disclaimer: This tool is intended for personal and educational audio conversion. We do not host copyrighted files on our servers.
      </p>
    </div>
  </div>
</footer>
